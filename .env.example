# ── Envoi d'emails (formulaire de contact) ──────────────────────────────
# Fournisseur : "resend" (par défaut) ou "smtp" (Brevo ou autre relais SMTP).
EMAIL_PROVIDER=resend

# Clé API Resend — https://resend.com
RESEND_API_KEY=

# Paramètres SMTP (utilisés si EMAIL_PROVIDER=smtp, ex. Brevo)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Expéditeur et destinataire des messages du formulaire
EMAIL_FROM="Site Pierre & Pavin <contact@votre-domaine.fr>"
EMAIL_TO="pierre.pavin75@gmail.com"

# ── Carte (page Contact) ────────────────────────────────────────────────
# "osm" (Leaflet/OpenStreetMap, par défaut) ou "google" (nécessite une clé).
NEXT_PUBLIC_MAP_PROVIDER=osm
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ── Analytics respectueux de la vie privée (optionnel, chargé en différé) ─
# Plausible : domaine déclaré dans le tableau de bord Plausible.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
